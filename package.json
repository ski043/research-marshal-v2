{
  "name": "research-marshal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify:stack": "vitest run --config verify/vitest.config.mts",
    "verify:run": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/verify-run.ts",
    "perf:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/perf-check.ts",
    "postinstall": "prisma generate",
    "bootstrap": "node scripts/setup-worktree.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "doctor:worktree": "node scripts/doctor.mjs",
    "research": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/research.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@base-ui/react": "^1.9.0",
    "@decodo/sdk-ts": "3.0.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "shadcn": "^4.23.0",
    "streamdown": "2.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
