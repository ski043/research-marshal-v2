[
  {
    "viewport": [1440, 900]
  },
  {
    "media": {
      "scheme": "light"
    }
  },
  {
    "goto": "/"
  },
  {
    "waitFor": "main canvas"
  },
  {
    "expect": "/^Good (morning|afternoon|evening)$/.test($v('h1').textContent)",
    "that": "the start screen greets by the local time"
  },
  {
    "expect": "$$v('textarea').length === 1",
    "that": "the app has one prompt box (U1)"
  },
  {
    "click": "button[aria-label^='Model']"
  },
  {
    "click": "[role=option]",
    "text": "Haiku"
  },
  {
    "wait": 300
  },
  {
    "expect": "$v(\"button[aria-label^='Model']\").textContent.includes('Haiku 5.5')",
    "that": "the prompt box shows the chosen model (M1)"
  },
  {
    "click": "textarea"
  },
  {
    "type": "failures"
  },
  {
    "press": "Enter"
  },
  {
    "waitFor": "section[aria-label='Progress']",
    "timeout": 30000
  },
  {
    "wait": 700
  },
  {
    "expect": "$v('main header').innerText.includes('Running')",
    "that": "the run is running right after the start"
  },
  {
    "expect": "[...$$v('main p')].some((p) => /^Haiku 5\\.5 · \\d{1,2} [A-Z][a-z]{2} \\d{4}, \\d{2}:\\d{2}$/.test(p.innerText.trim()))",
    "that": "the run shows its model under the question (M3)"
  },
  {
    "expect": "/\\S.*\\d:\\d\\d/s.test($v('main [data-slot=report-placeholder] p').innerText)",
    "that": "the main column says what the run is doing, with the elapsed time"
  },
  {
    "expect": "[...$$v('main header button')].some((b) => b.textContent.includes('Cancel')) && [...$$v('main button')].filter((b) => b.textContent.includes('Re-run')).length === 0",
    "that": "a running run has a Cancel button and no rerun button (U5)"
  },
  {
    "expect": "$v(\"nav[aria-label='Past runs'] a\").textContent.includes('Running:')",
    "that": "the history lists the run while it runs"
  },
  {
    "expect": "$$v(\"section[aria-label='Budget'] meter\").length === 4",
    "that": "the budget shows four meters (U4)"
  },
  {
    "shot": "running.png"
  },
  {
    "waitText": "Stopped because",
    "timeout": 60000
  },
  {
    "wait": 500
  },
  {
    "expect": "$$v(\"section[aria-label='Progress'] ol > li\").length === 11",
    "that": "the Activity list has the 11 actions of the failures scenario (U3)"
  },
  {
    "expect": "(() => { const header = $v('main header'); return !/Running|Completed|Finished/.test(header.innerText) && [...header.querySelectorAll('button')].every((b) => !/Cancel|Re-run/.test(b.textContent)); })()",
    "that": "the header of a completed run holds the question and the panel toggle, no status and no action"
  },
  {
    "expect": "!$v('main').innerText.includes('Finished') && $$v('main [data-slot=report-placeholder]').length === 0",
    "that": "the main column has no status block: the report follows the question"
  },
  {
    "expect": "['Searches 3', 'Pages read 1', 'failed 1', 'skipped 1', 'Claims verified 1', 'dropped 0'].every((t) => $v(\"section[aria-label='Budget']\").innerText.replace(/\\s+/g, ' ').includes(t))",
    "that": "the budget card counts the whole run, the failed and the skipped page included (F1)"
  },
  {
    "expect": "[...$$v('main button')].filter((b) => b.textContent.includes('Re-run')).length === 1 && [...$$v('main button')].filter((b) => b.textContent.includes('Re-run'))[0].closest('header') === null",
    "that": "the completed run has its rerun button under the question (U10)"
  },
  {
    "expect": "$v('article').innerText.includes('LFP cells last about 3,000 cycles')",
    "that": "the report is on the page"
  },
  {
    "expect": "$$v(\"article a[aria-label^='Citation']\").length >= 1",
    "that": "the report has a citation chip"
  },
  {
    "expect": "$v(\"nav[aria-label='Past runs'] a\").textContent.includes('Completed:')",
    "that": "the history shows the run as completed"
  },
  {
    "expect": "$v(\"meter[aria-label='Searches this round']\").value === 3",
    "that": "the budget counts the 3 searches of the round"
  },
  {
    "expect": "$$v('main textarea').length === 0",
    "that": "a run has no follow-up box (U2)"
  },
  {
    "shot": "completed.png"
  },
  {
    "reload": true
  },
  {
    "waitText": "Stopped because"
  },
  {
    "expect": "$$v(\"section[aria-label='Progress'] ol > li\").length === 11",
    "that": "the stored run shows the same 11 actions after a reload (U9)"
  },
  {
    "console": true
  }
]
