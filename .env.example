# The variables the app needs. `pnpm bootstrap` writes them to .env.local.
# Never commit a real value.
ANTHROPIC_API_KEY=
DECODO_AUTH_TOKEN=
DATABASE_URL=
# Optional. Set it to a pace in milliseconds, for example 0, to run every run
# on the offline fakes: no paid request, no API key.
# RESEARCH_MARSHAL_FAKES=
